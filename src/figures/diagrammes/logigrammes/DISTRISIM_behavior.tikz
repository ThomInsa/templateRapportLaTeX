\begin{tikzpicture}[
    node distance=2cm,
    every node/.style={font=\small},
    inputshort/.style={
        rectangle, rounded corners,
        draw, fill=ibisAmber!20,
        minimum width=1.2cm, minimum height=1cm,
        text width=1.2cm, align=center
    },
    inputlong/.style={
        rectangle, rounded corners,
        draw, fill=ibisCoral!20,
        minimum width=5cm, minimum height=1.3cm,
        text width=5cm, align=center
    },
    outputshort/.style={
        rectangle, rounded corners,
        draw, fill=ibisBlue!20,
        minimum width=1cm, minimum height=1cm
    },
    outputlong/.style={
        rectangle, rounded corners,
        draw, fill=ibisBlue!20,
        minimum width=3cm, minimum height=1cm,
        text width=3cm, align=center
    },
    process/.style={
        rectangle,
        draw, fill=ibisGray!15,
        minimum width=3cm, minimum height=1cm,
        align=center
    },
    decision/.style={
        diamond,
        draw, fill=ibisGreen!15,
        aspect=2,
        inner sep=2pt,
        text width=3cm,
        align=center
    },
    nestA/.style={
        rectangle,fill=ibisSky!30,
        draw, dashed,
        rounded corners=1mm,
        inner sep = 20pt
    },
    nestB/.style={rectangle,
    draw, dashed,
    fill=ibisIndigo!15,
    rounded corners=1mm,
    inner sep = 27pt
    },
    nestC/.style={rectangle,
    draw, dashed,
    fill=ibisViolet!15,
    rounded corners=1mm,
    inner sep = 27pt
    },
    arrow/.style={
        thick, ->, >=Stealth
    }
]

% Nodes
    \node (start) [process] {Récupération des \\ profils temporels du bâtiment \\ et de l'extérieur};

    \node (phiheat) [inputshort, below=of start, xshift = -4cm] {$\PhiEm{t}$};
    \node (phisol) [inputshort, below=of start, xshift = -2cm] {$\PhiSol{t}$};
    \node (phiint) [inputshort, below=of start] {$\PhiInt{t}$};
    \node (TExt) [inputshort, below=of start, xshift = 2cm] {$\TExt{t}$};
    \node (TAir) [inputshort, below=of start, xshift = 4cm] {$\TAir{t}$};

    \node (Pth) [inputlong, below=of phiint] {Paramètres thermiques $\PTh$ et système d'ODE associé};
    \node (solvparams) [inputlong, right=of Pth] {Période d'identification $T_i$ \\ Pas de temps $\tau$ \\ Températures initiales};
    \node (exo) [inputlong, left=of Pth] {Entrées exogènes};

    \node (REME) [process, below=of Pth] {Résolution du système d'ODE \\ par un solveur numérique};
    \node (obj) [outputlong, right=of REME] {Fonction objectif \\ $\Theta\left(\TAir{t}, \ThatAir{t}\right)$};

    \begin{scope}[on layer=bg1]
        \node (nesta) [nestA, fit=(start) (phiheat) (phisol) (phiint) (TExt) (TAir) (Pth) (solvparams) (exo) (REME) (obj), label={[anchor=north west]north west:Période d'entraînement du modèle $RC$, jusqu'à convergence de $\Theta$}] {};
    \end{scope}

    \node (PSO) [process, above=of start] {Algorithme \\ d'optimisation \\ des paramètres thermiques};
    \node (PSOparam) [inputlong, right=of PSO] {Fonction objectif \\ Bornes de recherche \\ Nb max d'itérations \\ Hyperparamètres};

    \node (Pthoptim) [outputlong, below=of REME] {$\PTh$ optimisé};
    \node (solvparamstest) [inputlong, right=of Pthoptim] {Période de validation $T_j$ \\ Pas de temps $\tau$ \\ Températures initiales};

    \node (calcultair) [process, below=of Pthoptim] {Calcul de $T_{\text{Air}}(t)$ \\ par résolution des ODE avec $\PTh$ optimisé};
    \node (testtair) [decision, below=of calcultair] {$T_{\text{Air}}(t) < \Tcons$};
    \node (Tconsint) [inputshort, left=of testtair] {$\Tcons$};
    \node (phiemzero) [process, right=of testtair] {$\phi_{\text{Em}}(t) \leftarrow 0$};
    \node (phiemnotzero) [process, below=of testtair] {$\phi_{\text{Em}}(t) \leftarrow \phi_{\text{Em}} \text{ tel que }  \phi_{\text{Em}}\left( \Tcons - T_{\text{Air}}(t) \right) = 0$};

    \node (phiemoutput) [outputlong, below=of phiemnotzero] {Profil de chauffage $\PhihatEm{t}$ prédit sur la période $T_j$};

    \begin{scope}[on layer=bg1]
        \node (nestc) [nestC, fit=(Tconsint) (calcultair) (testtair) (phiemzero) (phiemnotzero), label={[anchor=north west]north west:Pour $t$ allant de $1$ à $T_j$ par pas de $\tau$}] {};
    \end{scope}

    \begin{scope}[on layer=bg2]
        \node (nestb) [nestB, fit=(Pthoptim) (solvparamstest) (Tconsint) (calcultair) (testtair) (phiemzero) (phiemnotzero), label={[anchor=north west]north west:Période d'application du modèle $RC$}] {};
    \end{scope}

    % Arrows
    \draw [arrow] (start.south) -- ++(0, -0.5) -| (TAir.north);
    \draw [arrow] (start.south) -- ++(0, -0.5) -| (TExt.north);
    \draw [arrow] (start.south) -- ++(0, -0.5) -| (phiheat.north);
    \draw [arrow] (start.south) -- ++(0, -0.5) -| (phisol.north);
    \draw [arrow] (start.south) -- ++(0, -0.5) -| (phiint.north);

    \draw [arrow] (TExt.south) -- ++(0,-0.5) -| (exo.north);
    \draw [arrow] (phiheat.south) -- ++(0,-0.5) -| (exo.north);
    \draw [arrow] (phisol.south) -- ++(0,-0.5) -| (exo.north);
    \draw [arrow] (phiint.south) -- ++(0,-0.5) -| (exo.north);

    \draw [arrow] (exo.south) |- ++(0,-0.5) -| (REME.north);
    \draw [arrow] (Pth.south) |- ++(0,-0.5) -| (REME.north);
    \draw [arrow] (solvparams.south) |- ++(0,-0.5) -| (REME.north);

    \draw [arrow] (REME.east) -- (obj.west);
    \draw [arrow] (TAir.east) -- ++(5.75, 0) |- (obj.east);
    \draw [arrow] (PSOparam.west) -- (PSO.east);


    \draw [arrow] (Pthoptim.south) -- (calcultair.north);
    \draw [arrow] (calcultair.south) -- (testtair.north);
    \draw [arrow] (testtair.south) -- (phiemnotzero.north);
    \draw [arrow] (phiemnotzero.south) -- (phiemoutput.north);

    \draw [arrow] (solvparamstest.south) |- ++(0,-0.5) -| (calcultair.north);
    \draw [arrow] (testtair.east) -- (phiemzero.west);
    \draw [arrow] (Tconsint.east) -- (testtair.west);
    \draw [arrow] (Tconsint.south) |- (phiemnotzero.west);

    \draw [arrow, dashed] (PSO.south) -- (nesta.north);
    \draw [arrow] ([xshift=-8cm]nesta.south) |- (nestb.west);
%    \draw [arrow] (Tconsint.west) -- ++(-1, 0) |- ([yshift=-0.2cm]secante.east);
%    \draw [arrow] (REME.west) -| (Tairpred.north);

%    \draw [arrow] (secante.west) -| (phiempred.north);
%    \draw [arrow] (secante.east) -| (phisolpred.north);
\end{tikzpicture}