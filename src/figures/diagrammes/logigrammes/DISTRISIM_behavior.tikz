

\begin{tikzpicture}[
    node distance=2cm,
    every node/.style={font=\small},
    inputshort/.style={
        rectangle, rounded corners,
        draw, fill=orange!20,
        minimum width=1.2cm, minimum height=1cm,
        text width=1.2cm, align=center
    },
    inputlong/.style={
        rectangle, rounded corners,
        draw, fill=orange!20,
        minimum width=3cm, minimum height=1cm,
        text width=3cm, align=center
    },
    outputshort/.style={
        rectangle, rounded corners,
        draw, fill=blue!20,
        minimum width=1cm, minimum height=1cm
    },
    process/.style={
        rectangle,
        draw, fill=gray!15,
        minimum width=3cm, minimum height=1cm,
        align=center
    },
    decision/.style={
        diamond,
        draw, fill=green!15,
        aspect=2,
        inner sep=2pt,
        text width=2cm,
        align=center
    },
    arrow/.style={
        thick, ->, >=Stealth
    }
]

% Nodes
    \node (start) [process] {Récupération des \\ profils temporels du bâtiment};

    \node (Text) [inputshort, below right=of start] {$\TAir{t}$};
    \node (Tint) [inputshort, below right=of start, xshift = 2cm] {$\TExt{t}$};
    \node (phiheat) [inputshort, below right=of start, xshift = 4cm] {$\PhiHeat{t}$};
    \node (phisol) [inputshort, below right=of start, xshift = 6cm] {$\PhiSol{t}$};

    \node (fext) [inputshort, below=of Tint, xshift=1cm] {
        $\FExt$};
    \node (PSOparam) [inputlong, below=of fext, yshift=1.5cm] {Fonction objectif \\ Bornes de recherche \\ Taille de l'essaim \\ Nb max d'itérations};

    \node (PSOyn) [decision, below=of start, yshift=-0.5cm] {Paramètres thermiques \\ fixés ?};

    \node (Pth) [inputlong, below=of PSOyn, yshift=-2cm] {Vecteur Paramètres thermiques $\PTh$};
    \node (REME) [process, below=of Pth] {Résolution de l'équation \ref{eq:diffTST} \\ par la méthode d'Euler};
    \node (PSO) [process, right=of Pth, xshift=-0.5cm] {PSO \\ pour déterminer \\ les paramètres thermiques};
    \node (secante) [process, below=of REME] {Détermination du besoin de chauffage \\ par la méthode de la sécante};


    \node (Tairpred) [outputshort, below=of REME, xshift=-4.cm, yshift = 1.5cm] {$\ThatAir{t}$};
    \node (Tenvpred) [outputshort, below=of REME, xshift=4.cm, yshift = 1.5cm] {$\ThatEnv{t}$};


    \node (phiheatpred) [outputshort, below=of secante, xshift=-4cm, yshift = 1.5cm] {$\PhihatHeat{t}$};
    \node (phisolpred) [outputshort, below=of secante, xshift=4cm, yshift = 1.5cm] {$\PhihatSol{t}$};

    \node (Tconsext) [inputshort, right=of secante, xshift=2cm, yshift = 0.75cm] {$\Tconsext$};
    \node (Tconsint) [inputshort, right=of secante, xshift=2cm, yshift = -0.75cm] {$\Tconsint$};

% Arrows
    \draw [arrow] (start) -- (PSOyn);

    \draw [arrow] (start.east) -| (Text.north);
    \draw [arrow] (start.east) -| (Tint.north);
    \draw [arrow] (start.east) -| (phiheat.north);
    \draw [arrow] (start.east) -| (phisol.north);


    \draw [arrow] (Text.south) -- ++(0,-0.5) -| (fext.north);
    \draw [arrow] (Tint.south) -- ++(0,-0.5) -| (fext.north);
    \draw [arrow] (phiheat.south) -- ++(0,-0.5) -| (fext.north);
    \draw [arrow] (phisol.south) -- ++(0,-0.5) -| (fext.north);

    \draw [arrow] (PSOyn.south) -- node[left, text width=4cm, align=center] {oui \textit{(déterminés par la méthode 3CL ou par une précédente PSO)}} (Pth.north);
    \draw [arrow] (PSOyn.east) -| node[text width=1cm, align=left, yshift=0.2cm, xshift=-1cm] {non} (PSO.north);
%    \draw [arrow] (PSOyn.east) -- node[left, text width=4cm, align=center] {Non} (Pth.north);
    \draw [arrow] (Pth.south) -- (REME.north);
    \draw [arrow] (REME.south) -- (secante.north);

    \draw [arrow] (fext.west) -| (PSO.north);
    \draw [arrow] (PSOparam.west) -| (PSO.north);
    \draw [arrow] (PSO.west) -- (Pth.east);

    \draw [arrow] (Tconsext.west) -- ++(-1, 0) |- ([yshift=0.2cm]secante.east);
    \draw [arrow] (Tconsint.west) -- ++(-1, 0) |- ([yshift=-0.2cm]secante.east);

    \draw [arrow] (REME.west) -| (Tairpred.north);
    \draw [arrow] (REME.east) -| (Tenvpred.north);

    \draw [arrow] (secante.west) -| (phiheatpred.north);
    \draw [arrow] (secante.east) -| (phisolpred.north);

\end{tikzpicture}

