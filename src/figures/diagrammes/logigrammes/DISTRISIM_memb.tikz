\begin{tikzpicture}[
    process/.style={
        rectangle,
        draw, fill=ibisGray!15,
        minimum width=3cm, minimum height=1.3cm,
        align=center
    },
    outputshort/.style={
        rectangle, rounded corners,
        draw, fill=ibisBlue!20,
        minimum width=0.5cm, minimum height=1cm
    },
    nestA/.style={
        rectangle,fill=ibisBlue!30,
        rounded corners=0mm,
        inner sep = 20pt
    },
    nestB/.style={rectangle,
        fill=ibisGreen!15,
        rounded corners=0mm,
        inner sep = 27pt
    },
    arrow/.style={
        thick, ->, >=Stealth
    }
]
    \node (start) [process] {Calcul de \\ $\PTh$ par PSO \\ sur un mois};
    \node (mid) [outputshort, right=of start] {$\PTh$};
    \node (end) [process, right=of mid] {Prédiction de $\PhihatEm{t}$ en appliquant \\ $\PTh$ d'un mois à un autre};

    \begin{scope}[on layer=bg1]
        \node (nesta) [nestA, fit=(start) (mid) (end), label={[anchor=south west]south west:Pour chaque mois}] {};
    \end{scope}

    \begin{scope}[on layer=bg2]
        \node (nestb) [nestB, fit=(nesta), label={[anchor=south west]south west:Pour chaque bâtiment}] {};
    \end{scope}


    \draw [arrow] (start.east) -- (mid.west);
    \draw [arrow] (mid.east) -- (end.west);
    \draw [arrow] (end.south) -- ++(0, -1.5) -- ++(3.5, 0) -- ++(0, 4.2) -| node[text width=5cm, yshift=0.15cm, xshift=0.14cm, align=right] {Pour chaque mois} (end.north);

\end{tikzpicture}