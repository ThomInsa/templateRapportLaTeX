\begin{tikzpicture}[
    node distance=1.2cm and 2.5cm,
    every node/.style={draw, rectangle, rounded corners, align=center, minimum width=2.8cm, minimum height=0.9cm},
    arrow/.style={->, thick}
]

% --- Colonne 1 : Datasets ---
    \node (d1) {Dataset 1};
    \node (d2) [below=of d1] {Dataset 2};
    \node (d3) [below=of d2] {Dataset 3};
    \node (dN) [below=of d3] {$\vdots$ \\ Dataset N};

    \node[above=0.6cm of d1, draw=none] {\textbf{Datasets}};

% --- Colonne 2 : Méthodes ---
    \node (m1) [right=of d1] {Contrôle prédictif \\ (MPC)};
    \node (m2) [below=of m1] {Machine learning};
    \node (m3) [below=of m2] {Méthodes physiques \\ / hybrides};
    \node (mM) [below=of m3] {$\vdots$ \\ Méthode M};

    \node[above=0.6cm of m1, draw=none] {\textbf{Méthodes}};

% --- Colonne 3 : Modèles ---
    \node (model1) [right=of m1] {Modèle A \\ Performance};
    \node (model2) [below=of model1] {Modèle B \\ Performance};
    \node (model3) [below=of model2] {Modèle C \\ Performance};
    \node (modelX) [below=of model3] {$\vdots$ \\ Modèle X};

    \node[above=0.6cm of model1, draw=none] {\textbf{Modèles}};

% --- Connexions Datasets -> Méthodes ---
    \draw[arrow] (d1.east) -- (m1.west);
    \draw[arrow] (d1.east) -- (m2.west);
    \draw[arrow] (d2.east) -- (m1.west);
    \draw[arrow] (d2.east) -- (m3.west);
    \draw[arrow] (d3.east) -- (m2.west);
    \draw[arrow] (dN.east) -- (mM.west);

% --- Connexions Méthodes -> Modèles ---
    \draw[arrow] (m1.east) -- (model1.west);
    \draw[arrow] (m1.east) -- (model2.west);
    \draw[arrow] (m2.east) -- (model2.west);
    \draw[arrow] (m2.east) -- (model3.west);
    \draw[arrow] (mM.east) -- (modelX.west);

\end{tikzpicture}
