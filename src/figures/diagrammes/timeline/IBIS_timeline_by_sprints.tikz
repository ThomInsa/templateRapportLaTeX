    \begin{phases}
        \initialphase{involvement degree=1.75cm,phase color=black}
        \phase{between week=1 and 2 in 0.5, involvement degree=3cm, phase color=ibisViolet}
        \phase{between week=2 and 3 in 0.5, involvement degree=3cm, phase color=ibisGreen}
        \phase{between week=3 and 4 in 0.5, involvement degree=3cm, phase color=ibisViolet}
