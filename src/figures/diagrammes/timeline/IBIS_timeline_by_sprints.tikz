% put here the milestones
    \addmilestone{at=phase-0.90,direction=90:1cm,text={Début d'alternance},text options={above}}
    \addmilestone{at=phase-0.270,direction=270:1cm,text={Reprise du projet TST},text options={below}}

    \addmilestone{at=phase-1.270,direction=270:3cm,text=\shortstack{Construction \textit{from scratch} d'une arborescence de projet \\ Nettoyage des données et du code},text options={below, fill = white}}
