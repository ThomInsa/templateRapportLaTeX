    \addmilestone{at=phase-1.90,direction=90:3cm,text=\shortstack{Reproduction des précédents résultats et généralisation aux 11 bâtiments étudiés \\ Étude des limites de la PSO et de la méthode de la sécante},text options={above}}
    \addmilestone{at=phase-2.90,direction=90:1cm,text=\shortstack{Étendue des tests aux prédictions de $\PhiEm{t}$ \\ Analyse plus poussée des données d'entrée de DISTRISIM},text options={above}}
